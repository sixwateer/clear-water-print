<view class="page">
  <view class="hero">
    <text class="brand">净像 · 图片修复</text>
    <text class="subtitle">框住要去掉的目标，其余区域按背景与纹理补全。图片只在本机处理，不上传。</text>
  </view>

  <!-- 未选图：上传引导 -->
  <view class="card upload-card" wx:if="{{!hasImage}}">
    <view class="upload-ico">＋</view>
    <text class="upload-title">选择一张图片</text>
    <text class="upload-desc">支持相册或拍照 · JPG / PNG</text>
    <button class="btn-primary" bindtap="chooseImage">选择图片</button>
  </view>

  <block wx:else>
    <!-- 画布 + 框选 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">{{processed ? '修复结果' : '框选区域'}}</text>
        <text class="card-hint">{{processed ? '预览效果' : '拖动手柄缩放 · 拖动框内移动 · 空白处重画'}}</text>
      </view>

      <!-- 处理前：可交互画布 -->
      <view class="canvas-box" wx:if="{{!processed}}">
        <canvas type="2d" id="stage" class="stage"
          style="width:{{displayW}}px;height:{{displayH}}px;"
          disable-scroll="true"
          bindtouchstart="onTouchStart" catchtouchmove="onTouchMove" bindtouchend="onTouchEnd"></canvas>
      </view>
      <!-- 处理后：结果图 -->
      <view class="canvas-box" wx:else>
        <image class="result-img" src="{{resultPath}}" mode="widthFix"></image>
      </view>

      <view class="box-tools" wx:if="{{!processed}}">
        <button class="btn-mini" size="mini" bindtap="autoBox">自动框右下角</button>
        <button class="btn-mini" size="mini" data-d="-6" bindtap="adjustBox">框缩小</button>
        <button class="btn-mini" size="mini" data-d="6" bindtap="adjustBox">框放大</button>
        <button class="btn-mini" size="mini" bindtap="clearBox">清除框选</button>
      </view>
    </view>

    <!-- 处理结果操作 -->
    <view class="card" wx:if="{{processed}}">
      <text class="elapsed">{{elapsedText}}</text>
      <button class="btn-primary" bindtap="saveResult">保存到相册</button>
      <button class="btn-ghost" bindtap="nextImage">换下一张照片</button>
      <button class="btn-ghost" bindtap="reset">重新选图</button>
    </view>

    <!-- 设置面板 -->
    <view class="card" wx:if="{{!processed}}">
      <text class="section-label">修复框架（点击切换）</text>
      <view class="mode-list">
        <view wx:for="{{frameworks}}" wx:key="key"
          class="mode-item {{framework === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="setFramework">
          <text>{{item.label}}</text>
          <text class="mode-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
        </view>
      </view>
      <text class="mode-desc">{{frameworkDesc[framework]}}</text>

      <!-- 提示词 -->
      <view class="prompt-head">
        <text class="section-label">提示词（可选）</text>
        <text class="prompt-example-btn" catchtap="useExamplePrompt">用示例</text>
      </view>
      <textarea class="prompt-input" value="{{promptText}}" bindinput="onPromptInput"
        maxlength="300" auto-height show-confirm-bar="{{false}}"
        placeholder="描述框住的目标和补全依据，例如：去掉框住的蓝色包，其余按背景和人物衣物补全" />
      <view class="prompt-intent" wx:if="{{promptIntent}}">{{promptIntent}}</view>
      <view class="prompt-note">仅对框选区域生效；框外像素不做任何改动。</view>

      <view class="auth-row" bindtap="toggleAuth">
        <view class="checkbox {{authorized ? 'checked' : ''}}">{{authorized ? '✓' : ''}}</view>
        <text class="auth-text">我确认对此内容拥有处理权或已获授权</text>
      </view>
      <view class="compliance">{{compliance}}</view>

      <button class="btn-primary {{busy ? 'disabled' : ''}}" disabled="{{busy}}" bindtap="process">
        {{busy ? '修复中…' : '开始修复'}}
      </button>
    </view>
  </block>

  <view class="footer">
    <text class="privacy-link" bindtap="goPrivacy">用户协议与隐私政策</text>
    <text>净像 · 图片修复 v1.1 · 全程本地处理</text>
  </view>

  <!-- 隐藏离屏画布：老基础库（无 createOffscreenCanvas）时的修复兜底 -->
  <canvas type="2d" id="offstage" class="offstage"></canvas>
</view>
