.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 24rpx 60rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}
.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.nav-next {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  color: #0F9E8E;
  font-size: 22rpx;
  border: 2rpx solid rgba(15,158,142,0.35);
  border-radius: 999rpx;
  background: rgba(15,158,142,0.06);
}
.brand {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F9E8E;
}
.subtitle {
  margin-top: 10rpx;
  color: #5B6675;
  font-size: 24rpx;
  text-align: center;
}

.card {
  box-sizing: border-box;
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E7EBF0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(24,39,60,0.05);
}

.upload-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 70rpx 28rpx;
}
.upload-ico {
  width: 110rpx;
  height: 110rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #0F9E8E, #5B6EE1);
  color: #fff;
  font-size: 60rpx;
  font-weight: 300;
}
.upload-title {
  margin-top: 26rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.upload-desc {
  margin-top: 8rpx;
  color: #93A0B0;
  font-size: 24rpx;
}
.scene-block {
  width: 100%;
  margin-top: 48rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #EEF2F5;
}
.scene-title {
  display: block;
  text-align: center;
  color: #93A0B0;
  font-size: 22rpx;
}
.scene-row {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}
.scene-item {
  box-sizing: border-box;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 22rpx 8rpx;
  border: 2rpx solid #D8E6E3;
  border-radius: 16rpx;
  background: #F7FBFA;
}
.scene-label {
  color: #0B7A6E;
  font-size: 26rpx;
  font-weight: 600;
}
.scene-desc {
  color: #92A1AE;
  font-size: 20rpx;
}
.recent-card {
  padding-bottom: 24rpx;
}
.recent-row {
  display: flex;
  white-space: nowrap;
  margin-top: 18rpx;
}
.recent-item {
  display: inline-block;
  margin-right: 14rpx;
}
.recent-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #F0F4F6;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 650;
}
.card-hint {
  flex: 1;
  text-align: right;
  color: #93A0B0;
  font-size: 22rpx;
  line-height: 1.4;
}

.canvas-box {
  display: flex;
  justify-content: center;
  background: #0E141B;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 8rpx;
}
.stage {
  max-width: 100%;
}
.result-img {
  width: 100%;
}

.box-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.tool-row,
.mini-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}
.tool-item {
  flex: 1 1 calc(25% - 9rpx);
  box-sizing: border-box;
  padding: 14rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #5B6675;
  background: #F5F7F9;
  border: 2rpx solid #E7EBF0;
  border-radius: 12rpx;
}
.tool-item.active {
  color: #0B7A6E;
  font-weight: 600;
  background: rgba(15,158,142,0.10);
  border-color: #0F9E8E;
}

.section-label {
  font-size: 26rpx;
  font-weight: 650;
  color: #5B6675;
}
.mode-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}
.mode-item {
  box-sizing: border-box;
  flex: 0 0 calc(50% - 7rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #5B6675;
  background: #F5F7F9;
  border: 2rpx solid #E7EBF0;
  border-radius: 14rpx;
}
.mode-tag {
  font-size: 18rpx;
  opacity: 0.7;
}
.mode-item.active {
  color: #0B7A6E;
  font-weight: 600;
  background: rgba(15,158,142,0.08);
  border-color: #0F9E8E;
}
.mode-desc {
  display: block;
  margin-top: 16rpx;
  color: #93A0B0;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 提示词输入 */
.prompt-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}
.prompt-example-btn {
  color: #0F9E8E;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border: 2rpx solid rgba(15,158,142,0.35);
  border-radius: 10rpx;
}
.prompt-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  background: #F7F9FB;
  border: 2rpx solid #E7EBF0;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #2B3644;
}
.prompt-intent {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  background: rgba(15,158,142,0.08);
  border-left: 6rpx solid #0F9E8E;
  border-radius: 8rpx;
  color: #0B7A6E;
  font-size: 22rpx;
  line-height: 1.6;
}
.prompt-note {
  margin-top: 8rpx;
  color: #A0AAB7;
  font-size: 20rpx;
}
.elapsed {
  display: block;
  margin-bottom: 10rpx;
  color: #0B7A6E;
  font-size: 22rpx;
  text-align: center;
}

.auth-row {
  display: flex;
  align-items: center;
  margin: 26rpx 0 14rpx;
}
.checkbox {
  width: 34rpx;
  height: 34rpx;
  line-height: 32rpx;
  text-align: center;
  border: 2rpx solid #CFD8E3;
  border-radius: 8rpx;
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}
.checkbox.checked {
  background: #0F9E8E;
  border-color: #0F9E8E;
}
.auth-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #5B6675;
}
.compliance {
  padding: 16rpx;
  margin-bottom: 8rpx;
  background: rgba(224,160,32,0.08);
  border-radius: 12rpx;
  color: #8A6A20;
  font-size: 21rpx;
  line-height: 1.6;
}

.btn-primary {
  width: 100%;
  margin-top: 20rpx;
  background: linear-gradient(120deg, #0F9E8E, #0B7A6E);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-primary.disabled {
  opacity: 0.5;
}
.btn-ghost {
  width: 100%;
  margin-top: 16rpx;
  background: #FFFFFF;
  color: #0F9E8E;
  border: 2rpx solid #0F9E8E;
  font-size: 28rpx;
}
.btn-mini {
  background: #F5F7F9;
  color: #0B7A6E;
  font-size: 24rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  text-align: center;
  color: #B0BAC8;
  font-size: 20rpx;
}
.privacy-link {
  color: #0F9E8E;
  font-size: 22rpx;
  text-decoration: underline;
}

/* 隐藏离屏画布：移出可视区但保留渲染能力 */
.offstage {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  pointer-events: none;
}
